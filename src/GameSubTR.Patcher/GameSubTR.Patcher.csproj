<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameSubTR.Patcher</AssemblyName>
    <RootNamespace>GameSubTR.Patcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>..\GameSubTR.App\app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>GameSubTR Patcher - Otomatik Türkçe Yama</Product>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameSubTR.Core\GameSubTR.Core.csproj" />
    <ProjectReference Include="..\GameSubTR.Patching\GameSubTR.Patching.csproj" />
  </ItemGroup>
</Project>
