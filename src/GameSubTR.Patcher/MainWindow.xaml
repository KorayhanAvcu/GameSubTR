<Window x:Class="GameSubTR.Patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameSubTR Patcher — Otomatik Türkçe Yama" Width="740" Height="540" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">

        <!-- 1. Oyun seç -->
        <DockPanel x:Name="SelectPanel">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="Oyun seç" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                       Text="Oyunun kurulu olduğu klasörü seç ya da pencereye sürükle. Desteklenen motorlar: Ren'Py, RPG Maker MV/MZ." />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Klasör seç…" Click="OnBrowse" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="SteamLabel" Text="Steam oyunların (çift tıkla):" Margin="0,0,0,6" />
            <ListBox x:Name="SteamList" DisplayMemberPath="Name" MouseDoubleClick="OnSteamDoubleClick" />
        </DockPanel>

        <!-- 2. Algılama -->
        <DockPanel x:Name="DetectPanel" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" x:Name="GameName" />
            <TextBlock DockPanel.Dock="Top" x:Name="GamePath" Style="{StaticResource Hint}" />
            <TextBlock DockPanel.Dock="Top" x:Name="EngineText" FontSize="14" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
            <TextBlock DockPanel.Dock="Top" x:Name="InstalledText" Foreground="#1B6E2E" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"
                       Text="Bu oyunda yama kurulu." />
            <CheckBox DockPanel.Dock="Top" x:Name="FontCheck" IsChecked="True" Margin="0,0,0,12"
                      Content="Türkçe karakterli font kullan (ğ, ş, ı düzgün görünsün)" />
            <TextBlock DockPanel.Dock="Top" x:Name="StatsText" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← Başka oyun" Click="OnBack" />
                <Button x:Name="ExtractButton" Content="Metinleri çıkar" Click="OnExtract" />
                <Button x:Name="StartButton" Content="Çeviriyi başlat" Click="OnStart" Visibility="Collapsed" FontWeight="SemiBold" />
                <Button x:Name="UninstallButton" Content="Yamayı kaldır" Click="OnUninstall" Visibility="Collapsed" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- 3. Çeviri -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Title}" Text="Çevriliyor…" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="İptal edersen çevrilenler saklanır; sonra kaldığı yerden devam eder." />
            <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="1" Margin="0,0,0,8" />
            <TextBlock x:Name="ProgressText" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="İptal" Click="OnCancel" />
            </StackPanel>
        </StackPanel>

        <!-- 4. Sonuç -->
        <DockPanel x:Name="ResultPanel" Visibility="Collapsed">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" x:Name="ResultTitle" />
            <TextBlock DockPanel.Dock="Top" x:Name="ResultText" TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Başka oyun" Click="OnBack" />
                <Button x:Name="ResultUninstallButton" Content="Yamayı kaldır" Click="OnUninstall" />
                <Button Content="Oyun klasörünü aç" Click="OnOpenGameFolder" />
                <Button Content="Log klasörünü aç" Click="OnOpenLogs" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="FailedLabel" Text="Çevrilemeyen metinler (oyunda İngilizce kalır):" Margin="0,0,0,6" Visibility="Collapsed" />
            <ListBox x:Name="FailedList" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
