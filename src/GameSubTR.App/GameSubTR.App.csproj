<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameSubTR</AssemblyName>
    <RootNamespace>GameSubTR.App</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>GameSubTR - Oyun Altyazı Çevirici</Product>
    <!-- WPF + WinForms birlikte: belirsiz tipler için açık using kullanılıyor. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScreenCapture.NET.DX11" Version="*" />
    <PackageReference Include="Whisper.net" Version="1.*" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.*" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameSubTR.Core\GameSubTR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\silero_vad.onnx" Link="models\silero_vad.onnx" CopyToOutputDirectory="PreserveNewest" />
    <!-- Native hook dosyaları (native/build-*.sh veya CMake çıktısı) varsa yanına kopyalanır. -->
    <None Include="..\..\native\bin\*.dll;..\..\native\bin\*.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
